worker_processes 1;
error_log /dev/stderr warn;
events { worker_connections 4096; }
stream {
    map $ssl_preread_server_name $route {
        "" 127.0.0.1:28443;
        @PUBLIC_IP@ 127.0.0.1:28443;
        default 127.0.0.1:443;
    }
    server {
        listen 0.0.0.0:29443;
        ssl_preread on;
        preread_timeout 10s;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
        proxy_pass $route;
    }
}
http {
    access_log off;
    client_max_body_size 64k;
    limit_req_zone $binary_remote_addr zone=max_events:10m rate=20r/s;
    server {
        listen 127.0.0.1:28443 ssl;
        server_name @PUBLIC_IP@;
        ssl_certificate /etc/letsencrypt/live/bible-max-ip/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/bible-max-ip/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        location = /health { proxy_pass http://127.0.0.1:8081; }
        location = /ready { proxy_pass http://127.0.0.1:8081; }
        location = /max/webhook {
            limit_req zone=max_events burst=100 nodelay;
            limit_req_status 429;
            proxy_read_timeout 15s;
            proxy_pass http://127.0.0.1:8081;
        }
        location = /max/payments/yookassa {
            limit_req zone=max_events burst=30 nodelay;
            limit_req_status 429;
            proxy_read_timeout 35s;
            proxy_pass http://127.0.0.1:8081;
        }
        location = /max/payments/return { proxy_pass http://127.0.0.1:8081; }
        location / { return 404; }
    }
}
