# Render @ADMIN_DOMAIN@ after obtaining bible-admin-domain certificate.
# Install in certs/max-edge/letsencrypt/admin-http/panel.conf.
server {
    listen 127.0.0.1:28444 ssl;
    server_name @ADMIN_DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/bible-admin-domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bible-admin-domain/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    auth_basic "BibleMessengerBot admin";
    auth_basic_user_file /etc/letsencrypt/admin-auth/panel.htpasswd;
    client_max_body_size 32m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    location = / { return 302 /panel/; }
    location /panel/ { proxy_pass http://127.0.0.1:8080; }
    location /api/admin/ {
        limit_req zone=max_events burst=40 nodelay;
        limit_req_status 429;
        proxy_read_timeout 600s;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { return 404; }
}
