After=bible-max-edge.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bible-messenger-bot
Environment=MAX_EDGE_IP=82.38.69.203
Environment=MAX_EDGE_INTERFACE=ens1
ExecStart=/usr/bin/python3 /opt/bible-messenger-bot/scripts/max_https_edge.py guard
TimeoutStartSec=45s
UMask=0077
