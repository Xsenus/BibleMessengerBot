  "policy": "Complete scenes, speeches, arguments, psalms and independent wisdom sayings; exact native numbering, no arbitrary verse windows.",
  "notes": {
    "GEN:45:1:15": {
      "ru": "Иосиф открывается братьям и говорит о пережитых событиях.",
      "en": "Joseph reveals his identity to his brothers and speaks about what happened."
    },
    "GEN:50:15:21": {
      "ru": "После смерти Иакова братья боятся мести; Иосиф отвечает им.",
      "en": "After Jacob’s death the brothers fear revenge; Joseph answers them."
    },
    "JOB:19:1:29": {
      "ru": "Иов отвечает друзьям в страдании. Это его речь, а не обещание благополучия каждому читателю.",
      "en": "Job speaks to his friends in his suffering. This is his speech, not a promise of prosperity to every reader."
    },
    "JER:29:1:14": {
      "ru": "Письмо Иеремии переселенцам в Вавилоне: обещание возвращения связано с их положением и сроком изгнания.",
      "en": "Jeremiah’s letter to the exiles in Babylon: the promise of return concerns their situation and the duration of exile."
    },
    "2CH:7:11:22": {
      "ru": "Господь обращается к Соломону после освящения храма; рядом с обещанием приведены условия и предупреждение.",
      "en": "The Lord addresses Solomon after the temple’s dedication; the promise is accompanied by its conditions and warning."
    },
    "MAT:18:15:20": {
      "ru": "Иисус наставляет учеников об обличении, примирении и жизни общины.",
      "en": "Jesus teaches his disciples about correction, reconciliation and community life."
    },
    "JHN:3:1:21": {
      "ru": "Разговор Иисуса с Никодимом о новом рождении, вере и свете.",
      "en": "Jesus speaks with Nicodemus about new birth, faith and light."
    },
    "PHP:4:10:20": {
      "ru": "Павел благодарит за помощь и говорит о довольстве как в нужде, так и в достатке.",
      "en": "Paul gives thanks for support and speaks about contentment both in need and in abundance."
    },
    "1CO:13:1:13": {
      "ru": "Павел объясняет значение любви в связи с дарами и служением; рассуждение приведено целиком.",
      "en": "Paul explains the importance of love in relation to gifts and service; the argument is presented in full."
    }
  }
}