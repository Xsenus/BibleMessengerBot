# Telegram
BOT_TOKEN=replace_me
OWNER_CLAIM_CODE=replace_me_once

# PostgreSQL
POSTGRES_DB=biblebot
POSTGRES_USER=biblebot
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://biblebot:replace_me@postgres:5432/biblebot

# Admin API
ADMIN_API_KEY=replace_me
ADMIN_BIND=0.0.0.0
ADMIN_PORT=8080

# Bible import: core | extended | all-open | none
BIBLE_PROFILE=all-open
MAX_EDITIONS_PER_LANGUAGE=2
IMPORT_ON_START=true
ALLOW_RESTRICTED_LICENSES=false
ALLOW_UNKNOWN_LICENSES=false
IMPORT_BATCH_SIZE=2000
DOWNLOAD_TIMEOUT_SECONDS=180
SOURCE_CACHE_DIR=/app/cache

# Delivery
DEFAULT_TIMEZONE=Europe/Amsterdam
DEFAULT_SEND_TIME=09:00
WORKER_POLL_SECONDS=15
TELEGRAM_GLOBAL_RATE_PER_SECOND=20
TELEGRAM_CHAT_RATE_PER_SECOND=1
MAX_MESSAGE_LENGTH=3900
LOG_LEVEL=INFO

# Public URL is optional. Long polling works without a domain.
PUBLIC_BASE_URL=

REQUIRED_LANGUAGES=rus,eng
ADMIN_HOST_PORT=8080

# Multi-source import. No additional API keys are needed.
BIBLE_SOURCES=biblenlp,getbible,helloao
# latest resolves and pins one immutable BibleNLP commit per run; a full SHA is also supported.
BIBLENLP_REVISION=latest
# Leave filters empty to consider every approved edition in the chosen profile.
IMPORT_LANGUAGES=
IMPORT_EDITIONS=
IMPORT_RETRIES=5
IMPORT_REQUESTS_PER_SECOND=2
IMPORT_MIN_FREE_MB=1024
IMPORT_MAX_CACHE_MB=30720
IMPORT_MAX_FILE_MB=128

# Optional persistent artwork: manual | openai | auto (all configured providers).
ILLUSTRATION_PROVIDER=manual
OPENAI_API_KEY=
GEMINI_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
STABILITY_API_KEY=
IMAGE_PROVIDER_ORDER=openai,gemini,bfl,ideogram,stability
# One shared monthly budget across ALL providers, failures and fallback submissions.
IMAGE_MONTHLY_BUDGET_USD=10
# Daily attempts PER PROVIDER (UTC); exhausted providers are skipped in auto mode.
IMAGE_DAILY_MAX_REQUESTS=10

# Optional private S3 backups. Database snapshots are encrypted before upload.
S3_ENDPOINT=
S3_REGION=nl
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Generate 32 random bytes as 64 hex characters; keep an independent offline copy.
BACKUP_ENCRYPTION_KEY=
# Speech: local neural voices for Russian/Latin/Ancient Greek; shared MP3 cache.
AUDIO_ENABLED=true
AUDIO_PROVIDER=free
AUDIO_MODELS_PATH=/app/cache/tts
# Optional paid speech requires ALL three controls; image budgets are independent.
AUDIO_PAID_ENABLED=false
AUDIO_PAID_MONTHLY_MAX_CHARACTERS=0
AUDIO_PAID_DAILY_MAX_CHARACTERS=0
AUDIO_OPENAI_MODEL=gpt-4o-mini-tts
AUDIO_OPENAI_VOICE=marin
AUDIO_OPENAI_API_KEY=
